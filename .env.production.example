# Production environment template — copy to `.env.production` and fill in
# real values. Nothing here is a real secret; never commit `.env.production`.

# App
APP_ENV=production
APP_URL=https://hucha.id

# Database (PostgreSQL) — Neon connection strings with `?sslmode=require`.
# Required both at build time (static generation) and at runtime.
# DATABASE_URL: use the POOLED connection string (`-pooler` host) for the
# Next.js runtime on Vercel.
# DIRECT_URL: use the DIRECT connection string (non-pooled host) so Prisma
# CLI migrations run outside PgBouncer.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# Auth
# Generate a real secret (>= 32 chars): `openssl rand -base64 32`
# Production refuses the placeholder / short values.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://hucha.id

# Floating widget deep-link
WHATSAPP_ADMIN_NUMBER=+6282221918775

# Media storage — s3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO).
# Required on serverless platforms (Vercel) where the filesystem is ephemeral.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=
# Public base URL objects are served from (e.g. your CDN domain).
STORAGE_PUBLIC_URL=https://media.hucha.id
STORAGE_FORCE_PATH_STYLE=true

# Email delivery (best-effort notifications; leave unset to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hucha.id
