# App
# APP_ENV=production forces the production code path (SSL, etc.); it is
# inferred automatically when NODE_ENV=production (e.g. `next start`, Vercel).
APP_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL)
# Runtime uses DATABASE_URL. When using Neon, point this at the POOLED
# connection string (`-pooler` host) and set DIRECT_URL to the direct one
# so `prisma migrate deploy` runs on a non-pooled connection.
DATABASE_URL="postgresql://hucha:hucha@localhost:5432/hucha?schema=public"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/hucha?sslmode=require"

# Auth
# Generate a real secret (>= 32 chars): `openssl rand -base64 32`
# Production refuses the placeholder / short values.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Floating widget deep-link
WHATSAPP_ADMIN_NUMBER=+6282221918775

# Media storage.
# local (default) writes to /public/uploads — fine for dev / single-node.
# s3 is required for serverless deploys (Vercel): ephemeral filesystem.
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=auto
# STORAGE_BUCKET=hucha-media
# STORAGE_KEY=minio
# STORAGE_SECRET=minio-secret
# Public base URL objects are served from; defaults to <endpoint>/<bucket>.
# STORAGE_PUBLIC_URL=http://localhost:9000/hucha-media
# STORAGE_FORCE_PATH_STYLE=true

# Email delivery (optional — leave unset to disable email notifications)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@hucha.id
# SMTP_USER=
# SMTP_PASS=
